## 参数管理

```cpp
// 声明参数
this->declare_parameter("device_ip", "192.168.1.100");
this->declare_parameter("timeout_ms", 5000);

// 获取参数
auto ip = this->get_parameter("device_ip").as_string();
auto timeout = this->get_parameter("timeout_ms").as_int();

// 动态参数回调
auto param_callback = [this](const std::vector<rclcpp::Parameter>& params) {
    for (const auto& param : params) {
        if (param.get_name() == "timeout_ms") {
            timeout_ms_ = param.as_int();
        }
    }
    return rcl_interfaces::msg::SetParametersResult();
};
param_callback_handle_ = this->add_on_set_parameters_callback(param_callback);
```

