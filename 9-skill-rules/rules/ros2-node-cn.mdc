## 生命周期管理

### 优雅关闭

```cpp
class MyNode : public rclcpp::Node {
public:
    ~MyNode() {
        // 清理资源
        stopDevice();
    }
    
    void stopDevice() {
        if (device_running_) {
            device_running_ = false;
            // 等待线程结束
            if (worker_thread_.joinable()) {
                worker_thread_.join();
            }
        }
    }
};
```

### 信号处理

```cpp
int main(int argc, char** argv) {
    rclcpp::init(argc, argv);
    
    auto node = std::make_shared<MyNode>();
    
    // 优雅关闭
    rclcpp::on_shutdown([node]() {
        node->stopDevice();
    });
    
    rclcpp::spin(node);
    rclcpp::shutdown();
    return 0;
}
```

